{
  "name": "md2pdf-local",
  "version": "1.0.0",
  "description": "Offline Markdown to PDF converter: marked + Playwright + your locally installed Chrome/Edge. Nothing is uploaded.",
  "type": "module",
  "bin": {
    "md2pdf": "./bin/md2pdf.mjs"
  },
  "files": [
    "bin",
    "src",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "markdown",
    "pdf",
    "offline",
    "privacy",
    "playwright",
    "marked",
    "cjk",
    "chinese"
  ],
  "license": "MIT",
  "dependencies": {
    "marked": "^17.0.0",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.62.0"
  },
  "optionalDependencies": {
    "pdfjs-dist": "^5.6.0"
  }
}
